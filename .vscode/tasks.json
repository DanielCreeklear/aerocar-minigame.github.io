{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local server",
      "type": "shell",
      "command": "npm run dev",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\bvite\\b",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
